GH_OWNER=mbround18
BASE_URL=http://localhost:8080

# GitHub App (used for repo reads + archive/disable-actions actions)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_INSTALLATION_ID=   # optional; discovered by owner login otherwise
# Optional classic PAT with `user` scope: enables the real billing API for the usage alert.
# GITHUB_TOKEN=
SESSION_SECRET=change-me-long-random

# Mail: set RESEND_API_KEY *or* SMTP_*
MAIL_TO=you@example.com
MAIL_FROM=knock-knock@example.com
# RESEND_API_KEY=
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=  SMTP_STARTTLS=true

# Thresholds (defaults shown)
ARCHIVE_IDLE_DAYS=365
ARCHIVE_POPULAR_SCORE=5
CI_OFF_RUNS_30D=5
PRIVATE_MINUTES_30D=60
HEAVY_MINUTES_30D=500
BOT_RUNS_30D=40
REPORT_MIN_ITEMS=1
RENOTIFY_DAYS=14
USAGE_ALERT_PCTS=50,75,90
ACTIONS_QUOTA_MINUTES=2000
